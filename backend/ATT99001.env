# Copier ce fichier en .env et adapter les valeurs.

# Serveur
PORT=3000
CLIENT_ORIGIN=http://localhost:4200

# Base de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=laposte_eboutique

# Sécurité — METTRE UNE VRAIE CLÉ SECRÈTE EN PRODUCTION
JWT_SECRET=dev-secret-a-changer
JWT_EXPIRES_IN=7d

# Clé de chiffrement des messages internes
CHAT_SECRET=dev-chat-secret-a-changer

# Envoi d'e-mails (vérification, réinitialisation, code 2FA)
# Laisser SMTP_HOST vide => mode démo : les e-mails s'affichent dans la console
# du serveur (le lien / le code OTP y sont lisibles pour la soutenance).
# Pour de vrais e-mails (ex. Gmail), renseigner :
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=votre.adresse@gmail.com
#   SMTP_PASSWORD=mot_de_passe_application
#   SMTP_FROM=e-Boutique La Poste <votre.adresse@gmail.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=benayedsarra1604@gmail.com
SMTP_PASSWORD=bqnopqfwseujjbgr
SMTP_FROM=e-Boutique La Poste Tunisienne <benayedsarra1604@gmail.com>
