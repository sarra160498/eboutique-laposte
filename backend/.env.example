# Copier ce fichier en .env et adapter les valeurs.

# Serveur
PORT=3000
CLIENT_ORIGIN=http://localhost:4200

# Base de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=laposte_eboutique

# Sécurité — METTRE UNE VRAIE CLÉ SECRÈTE EN PRODUCTION
JWT_SECRET=dev-secret-a-changer
JWT_EXPIRES_IN=7d

# Clé de chiffrement des messages internes
CHAT_SECRET=dev-chat-secret-a-changer

# Envoi d'e-mails (vérification, réinitialisation, code 2FA)
# Laisser SMTP_HOST vide => mode démo : les e-mails s'affichent dans la console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=e-Boutique La Poste Tunisienne <no-reply@laposte.tn>
# Si l'envoi échoue avec « self-signed certificate in certificate chain »
# (antivirus/pare-feu qui inspecte le TLS), mettre true — DÉVELOPPEMENT SEULEMENT.
SMTP_ALLOW_SELF_SIGNED=false
